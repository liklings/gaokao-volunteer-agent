# 复制这个文件为 .env，然后按需填写。.env 本身已经在 .gitignore 里，
# 不会被提交到仓库——千万不要把真实的 .env 文件提交上去。

# --- 数据库 ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gaokao_agent

# --- Gemini ---
# 从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- 认证 ---
# 必填，没有默认值。生成一个随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 生产环境务必用一个跟这里不同、只有你自己知道的值，且不要复用在别的项目上。
JWT_SECRET=

# --- 应用元信息 ---
# local | docker | production —— production 时会额外开启 HSTS 响应头（见 app/middleware.py）
ENVIRONMENT=local

# 允许跨域访问后端的前端源，JSON 数组格式（注意跟其他变量不同，这个是 JSON 而不是逗号分隔）：
# CORS_ORIGINS=["https://your-frontend-domain.com"]
# 不配置的话用代码里的默认值（本地开发用的几个 localhost 端口）。
